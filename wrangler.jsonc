{
  "name": "buddyclip-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./docs",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "clip.buddytools.org", "custom_domain": true },
    { "pattern": "clip.buddytools.org/*", "zone_name": "buddytools.org" }
  ],
  "workers_dev": false,
  "preview_urls": false
}
